diff --git a/Dockerfile b/Dockerfile
index fd39884..ce8bab1 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -8,7 +8,7 @@
 #   x86_64  -> nvidia/cuda base
 #   aarch64 -> NGC PyTorch base (only CUDA-enabled PyTorch source on ARM)

-FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04 AS base-amd64
+FROM nvcr.io/nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04 AS base-amd64
 FROM nvcr.io/nvidia/pytorch:25.08-py3 AS base-arm64
 ARG TARGETARCH
 FROM base-${TARGETARCH}
@@ -26,6 +26,10 @@ RUN apt-get update && apt-get install -y \
     libgl1 \
     && rm -rf /var/lib/apt/lists/*

+# Protocol v2 fetches from GitHub fail on the cluster with "expected flush after
+# ref listing"; v1 does not.
+RUN git config --global protocol.version 1
+
 # gsplat builds CUDA extensions at runtime. Pin the host compiler to a CUDA-compatible
 # toolchain and use ninja when torch compiles the extension.
 ENV CC=/usr/bin/gcc-11
@@ -50,9 +54,11 @@ RUN uv run compile-protos --no-sync

 WORKDIR /repo

+# Every core package except the driver: the garage driver runs on the host, and the
+# driver member is the only one that installs from GitHub.
 RUN --mount=type=secret,id=netrc,target=/root/.netrc \
     --mount=type=cache,target=/root/.cache/uv \
-    sh -c 'if [ -f /root/.netrc ]; then export NETRC=/root/.netrc; fi && uv sync --extra all --extra mtgs'
+    sh -c 'if [ -f /root/.netrc ]; then export NETRC=/root/.netrc; fi && uv sync --extra plugins --extra controller --extra eval --extra grpc --extra runtime --extra utils --extra physics --extra tools --extra wizard --extra mtgs'

 ENV UV_CACHE_DIR=/tmp/uv-cache
 ENV UV_NO_SYNC=1
