+_INVERSE_RECTIFICATION_MAPS: "OrderedDict[tuple, tuple]" = OrderedDict()
+_INVERSE_RECTIFICATION_MAPS_MAX = 64
+
+
+def _inverse_rectification_map(intrinsic, distortion, width, height):
+    # The maps depend only on the camera model, which repeats across scenes, and cost ~0.5 s per camera.
+    key = (intrinsic.tobytes(), distortion.tobytes(), int(width), int(height))
+    maps = _INVERSE_RECTIFICATION_MAPS.get(key)
+    if maps is None:
+        new_intrinsic, _ = cv2.getOptimalNewCameraMatrix(
+            intrinsic, distortion, (width, height), 1
+        )
+        maps = (
+            new_intrinsic,
+            cv2.initInverseRectificationMap(
+                intrinsic, distortion, None, new_intrinsic, (width, height), cv2.CV_32FC1
+            ),
+        )
+        _INVERSE_RECTIFICATION_MAPS[key] = maps
+        while len(_INVERSE_RECTIFICATION_MAPS) > _INVERSE_RECTIFICATION_MAPS_MAX:
+            _INVERSE_RECTIFICATION_MAPS.popitem(last=False)
+    return maps
+
